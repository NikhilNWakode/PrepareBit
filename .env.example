# ---------------------------------------------------------------------------
# Copy to .env and fill in. Only the "required now" block is needed to boot.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# MongoDB connection string. A local server or a free MongoDB Atlas cluster.
# Required by the API server only. The batch entry point does not use a database,
# so `npm run evaluate` runs without it.
MONGODB_URI=mongodb://127.0.0.1:27017/interview-prep-kit

# Origin allowed to call the API with credentials (the Next.js app).
WEB_ORIGIN=http://localhost:3000

# Signing secret for the session cookie. Minimum 16 characters.
# Required by the API server only, like MONGODB_URI.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me-to-a-long-random-string

# Database used by the integration test suites. Must contain "test" in its
# name, because those suites clear collections between tests. Suites skip
# cleanly when no database is reachable, so `npm test` still passes without one.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/interview-prep-kit-test

# Where the Next.js app proxies /api/* to. Read by the web app at build time,
# so it points at the deployed Express URL in production.
API_ORIGIN=http://localhost:4000


# --- Used from Phase 5 (LLM generation) -------------------------------------

# Which provider implements the LLM interface. Only "groq" is implemented.
LLM_PROVIDER=groq

# Free key from https://console.groq.com — no card required.
GROQ_API_KEY=

# Groq free-tier limits are bucketed per model, so heavy-context and
# high-frequency stages are routed to different models on purpose.
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Caches LLM responses on disk during development so iterating on the UI does
# not burn the daily free-tier token allowance. Never enable in production.
LLM_CACHE=false


# --- Used from Phase 4 (retrieval and public interview research) ------------

# Optional. Free tier at https://tavily.com. Without it the system falls back
# to DuckDuckGo, and reports an empty result honestly if both are unavailable.
TAVILY_API_KEY=

# Allows crawling private/loopback addresses. Defaults to true outside
# production because the batch entry point is run against company sites served
# from localhost. Must stay false in production (SSRF protection).
# ALLOW_PRIVATE_URLS=true
